     1 using System.Collections;
     2 using UnityWorld.Core;
     3 using UnityWorld.Game.Data;
     4 
     5 namespace UnityWorld.Game.Domain
     6 {
     7     /// <summary>
     8     /// 叙事管理器：天地人三池调度与统一触发入口
     9     /// 天（宿命池）：时间到达后触发预写事件
    10     /// 地（劫缘池）：周期性权重随机触发环境事件
    11     /// 人（抉择池）：由 BehaviorCardMgr 驱动，通过此管理器统一触发
    12     /// </summary>
    13     public class StoryMgr : IDomainMgrBase
    14     {
    15         // ── 单例 ─────────────────────────────────────────────
    16         public static StoryMgr? Instance { get; private set; }
    17 
    18         // ── IDomainMgrBase ────────────────────────────────────
    19         public string Name => "StoryMgr";
    20         public string Desc => "叙事事件管理器：天地人三池调度与统一触发入口";
    21 
    22         // ── 配置 ──────────────────────────────────────────────
    23         /// <summary>劫缘池触发周期（游戏时间单位），默认 30 秒</summary>
    24         public float KarmaTriggerInterval { get; set; } = 30f;
    25 
    26         // ── 内部状态 ──────────────────────────────────────────
    27         private readonly Dictionary<int, FatePool>  _fatePools  = new();
    28         private readonly Dictionary<int, KarmaPool> _karmaPools = new();
    29         private float   _karmaTimer = 0f;
    30         private float   _currentTime = 0f;
    31         private Rng?    _rng;
    32 
    33         // ── 全局故事池（用于 TriggerByTag 匹配） ─────────────
    34         // 所有 StoryDefine 的 Tags 映射，懒加载
    35         private Dictionary<string, List<string>>? _storyTagsCache;
    36 
    37         // ── 构造 ──────────────────────────────────────────────
    38         public StoryMgr(int seed = 0)
    39         {
    40             Instance = this;
    41             _rng     = new Rng(seed);
    42         }
    43 
    44         // ── IDomainMgrBase 生命周期 ───────────────────────────
    45 
    46         /// <summary>无耦合初始化</summary>
    47         public void Init()
    48         {
    49             _karmaTimer  = 0f;
    50             _currentTime = 0f;
    51         }
    52 
    53         /// <summary>有耦合初始化：构建 StoryDefine 双向 Option 合并表</summary>
    54         public void Begin()
    55         {
    56             StoryDefineMgr.Instance?.BuildMergedOptions();
    57             LogMgr.Dbg("[StoryMgr] Begin：双向 Option 合并完成");
    58         }
    59 
    60         /// <summary>Tick：推进宿命池时间检查 + 劫缘池周期触发</summary>
    61         public void Tick(float deltaTime)
    62         {
    63             _currentTime += deltaTime;
    64 
    65             // ① 宿命池：推进所有主体的 FatePool
    66             foreach (var (npcId, fatePool) in _fatePools)
    67                 fatePool.Tick(_currentTime);
    68 
    69             // ② 劫缘池：周期触发
    70             _karmaTimer += deltaTime;
    71             if (_karmaTimer >= KarmaTriggerInterval)
    72             {
    73                 _karmaTimer = 0f;
    74                 TriggerAllKarmaPools();
    75             }
    76         }
    77 
    78         public void Update()  { }
    79         public void Render(float dt) { }
    80 
    81         /// <summary>清理</summary>
    82         public void End()
    83         {
    84             _fatePools.Clear();
    85             _karmaPools.Clear();
    86             _storyTagsCache = null;
    87         }
    88 
    89         public IEnumerator Save() { yield break; }
    90         public IEnumerator Load() { yield break; }
    91 
    92         /// <summary>日志输出（输出Name、Desc、存的数据信息的数量与概括）</summary>
    93         public void Log()
    94         {
    95             LogMgr.Dbg("[{0}] {1} | FatePools={2}, KarmaPools={3}", Name, Desc, _fatePools.Count, _karmaPools.Count);
    96         }
    97 
    98         // ── 公共 API：三池管理 ────────────────────────────────
    99 
   100         /// <summary>向指定 NPC 的宿命池添加条目</summary>
   101         public void AddToFatePool(int npcId, float triggerTime, string storyId)
   102         {
   103             if (!_fatePools.TryGetValue(npcId, out var pool))
   104             {
   105                 pool = new FatePool();
   106                 pool.OnTrigger = (sid, time) => OnFateTrigger(npcId, sid);
   107                 _fatePools[npcId] = pool;
   108             }
   109             pool.Add(triggerTime, storyId);
   110         }
   111 
   112         /// <summary>向指定 NPC 的劫缘池添加条目</summary>
   113         public void AddToKarmaPool(int npcId, string storyId, float weight, List<StoryCondition>? conditions = null)
   114         {
   115             if (!_karmaPools.TryGetValue(npcId, out var pool))
   116             {
   117                 pool = new KarmaPool();
   118                 _karmaPools[npcId] = pool;
   119             }
   120             pool.Add(storyId, weight, conditions);
   121         }
   122 
   123         // ── 公共 API：统一触发入口 ────────────────────────────
   124 
   125         /// <summary>
   126         /// 统一触发入口：通过 StoryId 触发一个故事事件
   127         /// 三池（宿命/劫缘/抉择）均通过此方法触发，屏蔽来源差异
   128         /// </summary>
   129         public void TriggerStory(string storyId, object? subject, StoryPoolSource source = StoryPoolSource.Fate, Rng? rng = null)
   130         {
   131             var define = StoryDefineMgr.Instance?.Get(storyId);
   132             if (define == null)
   133             {
   134                 LogMgr.Warn("[StoryMgr] TriggerStory 找不到 StoryDefine '{0}'", storyId);
   135                 return;
   136             }
   137 
   138             var ctx = new StoryContext(subject, source, _currentTime, rng ?? _rng, storyId);
   139 
   140             // ① 检查 Conditions
   141             if (!define.EvaluateConditions(ctx))
   142             {
   143                 LogMgr.Dbg("[StoryMgr] Story '{0}' Conditions 不满足，跳过触发", storyId);
   144                 return;
   145             }
   146 
   147             // ② Lua 复杂轨检查（预留，当前降级到简单轨）
   148             if (!string.IsNullOrEmpty(define.LuaScript))
   149             {
   150                 LogMgr.Warn("[StoryMgr] Story '{0}' 配置了 LuaScript 但 Lua 尚未集成，降级到简单轨执行", storyId);
   151             }
   152 
   153             // ③ 执行 Effects（简单轨）
   154             StoryEffectFunc.ExecuteAll(define.Effects, ctx);
   155 
   156             // ④ 若为显示事件，广播 UI 事件
   157             if (!define.IsHide)
   158             {
   159                 LogMgr.Dbg("[StoryMgr] 显示 Story '{0}' 触发，广播 UI 事件", storyId);
   160                 EventMgr.Instance?.TriggerEvent(
   161                     "story.show",
   162                     new { StoryId = storyId, Subject = subject, Options = define.MergedOptionIds },
   163                     (Scope.Global, "")
   164                 );
   165             }
   166             else
   167             {
   168                 LogMgr.Dbg("[StoryMgr] 隐形 Story '{0}' 触发完成", storyId);
   169             }
   170         }
   171 
   172         /// <summary>
   173         /// 通过 Tags 在全局 StoryPool 中 TagBag 匹配后触发权重最高的 Story
   174         /// </summary>
   175         public void TriggerStoryByTags(List<string> tags, object? subject, StoryPoolSource source = StoryPoolSource.Karma, Rng? rng = null)
   176         {
   177             BuildStoryTagsCache();
   178             if (_storyTagsCache == null || _storyTagsCache.Count == 0) return;
   179 
   180             // 简单 Include 匹配：找交集最多的 Story
   181             string? bestId   = null;
   182             int     bestScore = -1;
   183             var     querySet  = new HashSet<string>(tags, StringComparer.OrdinalIgnoreCase);
   184 
   185             foreach (var (storyId, storyTags) in _storyTagsCache)
   186             {
   187                 int score = storyTags.Count(t => querySet.Contains(t));
   188                 if (score > bestScore)
   189                 {
   190                     bestScore = score;
   191                     bestId    = storyId;
   192                 }
   193             }
   194 
   195             if (bestId != null && bestScore > 0)
   196                 TriggerStory(bestId, subject, source, rng);
   197             else
   198                 LogMgr.Dbg("[StoryMgr] TriggerStoryByTag 未找到匹配的 Story，tags={0}", string.Join(",", tags));
   199         }
   200 
   201         // ── 内部方法 ──────────────────────────────────────────
   202 
   203         private void OnFateTrigger(int npcId, string storyId)
   204         {
   205             var subject = NpcMgr.Instance?.GetById(npcId);
   206             TriggerStory(storyId, subject, StoryPoolSource.Fate, _rng);
   207         }
   208 
   209         private void TriggerAllKarmaPools()
   210         {
   211             foreach (var (npcId, karmaPool) in _karmaPools)
   212             {
   213                 var subject = NpcMgr.Instance?.GetById(npcId);
   214                 var ctx     = new StoryContext(subject, StoryPoolSource.Karma, _currentTime, _rng);
   215                 karmaPool.OnTrigger ??= (sid) => TriggerStory(sid, subject, StoryPoolSource.Karma, _rng);
   216                 karmaPool.TryTrigger(_rng!, ctx);
   217             }
   218         }
   219 
   220         private void BuildStoryTagsCache()
   221         {
   222             if (_storyTagsCache != null) return;
   223             _storyTagsCache = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
   224             var all = StoryDefineMgr.Instance?.GetAll();
   225             if (all == null) return;
   226             foreach (var s in all)
   227                 _storyTagsCache[s.ID] = s.Tags;
   228         }
   229     }
   230 }
   231 


## 来自 CodeMaker 的消息
让我再看看 NPC 的一些 Data 类型和 WorldMgr 的初始化流程，了解全貌。

## 工具调用结果
     1 using UnityWorld.Game.Data;
     2 using UnityWorld.Game.Domain;
     3 using UnityWorld.Core;
     4 
     5 namespace UnityWorld.Game.World
     6 {
     7     /// <summary>
     8     /// World管理器：统一Tick入口，持有所有顶层子系统
     9     /// </summary>
    10     public static class WorldMgr
    11     {
    12         public static List<IDomainMgrBase> _mgrs = new();  // 统一管理列表，方便统一Tick
    13 
    14         // ── 元气系统 ──────────────────────────────────────
    15 
    16         /// <summary>元气天道管理器：持有原初快照、计算五行收支偏差、暴露失衡权重</summary>
    17         public static AuraDaoMgr AuraDaoMgr { get; private set; } = new();
    18 
    19         /// <summary>地块元气系统：每 Tick 将 TileModifier 累积到 Tile.CurrentAura 并清理过期修正</summary>
    20         public static TileSystemAura TileSystemAura { get; private set; } = new();
    21 
    22         /// <summary>
    23         /// 初始化世界（游戏启动时调用）：
    24         ///   1. 加载外部数据定义（GameDataMgr）
    25         ///   2. 初始化世界时间
    26         ///   3. 初始化NPC管理器
    27         ///   4. 初始化位面管理器（含主世界，并拍摄原初元气快照）
    28         /// </summary>
    29         public static void Initialize(int seed = 12345)
    30         {
    31             GameDataMgr.Initialize();
    32             WorldTime.Initialize(seed);
    33             _mgrs.Add(new TraitMgr());
    34             _mgrs.Add(new NpcMgr(seed));
    35             _mgrs.Add(new CultivationMgr());
    36 
    37             // LandMarkMgr / RegionMgr 须在 PlaneMgr 之前初始化，
    38             // 以确保 PlaneMgr.CreatePlane 中 PlaneGenerator.Generate 可访问它们的 Instance
    39             _mgrs.Add(new LandMarkMgr());
    40             _mgrs.Add(new RegionMgr());
    41 
    42             // PlaneMgr 需要 AuraDaoMgr 引用，以便 Generate() 完成后自动拍摄自然快照
    43             var planeMgr = new PlaneMgr(seed) { AuraDaoMgr = AuraDaoMgr };
    44             _mgrs.Add(planeMgr);
    45 
    46             // TileMgr 在 PlaneMgr 之后初始化（需要 PlaneMgr.Instance）
    47             _mgrs.Add(new TileMgr());
    48 
    49             // ── Stat 属性系统（须在 FlagMgr 之后、NPC 使用前初始化）──
    50             _mgrs.Add(new StatMgr());
    51 
    52             // ── Flag 黑板系统（叙事系统依赖，须先于 StoryMgr 初始化）──
    53             _mgrs.Add(new FlagMgr());
    54 
    55             // ── 叙事系统 ──────────────────────────────────────
    56             _mgrs.Add(new StoryMgr(seed));
    57             _mgrs.Add(new BehaviorCardMgr());
    58 
    59             foreach (var mgr in _mgrs) mgr.Init();  // 初始化时先Tick一次，建立初始状态（如生成NPC）
    60         }
    61 
    62         public static void Start()
    63         {
    64             var eventCount = EventDefineMgr.Instance?.GetAll() is var all ? System.Linq.Enumerable.Count(all) : 0;
    65             LogMgr.Dbg("[WorldMgr] 已加载 {0} 个事件定义", eventCount);
    66             Console.WriteLine("=== 世界初始化完成 ===\n");
    67         }
    68 
    69         /// <summary>
    70         /// 全局Tick入口：按优先级顺序驱动所有子系统
    71         /// 顺序：WorldTime → PlaneMgr → NpcMgr → TileSystemAura → AuraDaoMgr → (后续系统...)
    72         /// </summary>
    73         public static void Tick(float deltaTime)
    74         {
    75             // ① 推进世界物理时间
    76             WorldTime.Advance(deltaTime);
    77 
    78             foreach (var mgr in _mgrs) mgr.Tick(deltaTime);  // 统一驱动所有注册的子系统（如 TraitMgr）
    79 
    80             // ② 元气系统：先累积 Modifier 到 CurrentAura，再让天道感知最新状态
    81             var planeMgr = PlaneMgr.Instance;
    82             if (planeMgr?.MainPlane != null)
    83             {
    84                 TileSystemAura.Tick(planeMgr.MainPlane, deltaTime);
    85             }
    86             AuraDaoMgr.OnTick(deltaTime);
    87         }
    88     }
    89 }


