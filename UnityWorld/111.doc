     1 using System.Collections;
     2 using UnityWorld.Core;
     3 using UnityWorld.Game.Data;
     4 
     5 namespace UnityWorld.Game.Domain
     6 {
     7     /// <summary>
     8     /// 行为卡运行时管理器（人·抉择池驱动核心）
     9     /// 维护所有 NPC 持有的 BehaviorCard 实例，提供发卡、查卡、用卡、移除功能
    10     /// UseCard 最终通过 StoryMgr.TriggerStory 统一触发，屏蔽与三池其他来源的差异
    11     /// </summary>
    12     public class BehaviorCardMgr : IDomainMgrBase
    13     {
    14         // ── 单例 ─────────────────────────────────────────────
    15         public static BehaviorCardMgr? Instance { get; private set; }
    16 
    17         // ── IDomainMgrBase ────────────────────────────────────
    18         public string Name => "BehaviorCardMgr";
    19         public string Desc => "行为卡运行时管理器：人·抉择池驱动核心";
    20 
    21         // ── 内部数据 ──────────────────────────────────────────
    22         /// <summary>int → 该 NPC 持有的行为卡列表</summary>
    23         private readonly Dictionary<int, List<BehaviorCard>> _cardTable = new();
    24 
    25         // ── 构造 ──────────────────────────────────────────────
    26         public BehaviorCardMgr()
    27         {
    28             Instance = this;
    29         }
    30 
    31         // ── IDomainMgrBase 生命周期 ───────────────────────────
    32         public void Init()   { }
    33         public void Begin()  { }
    34         public void Tick(float deltaTime) { }
    35         public void Update() { }
    36         public void Render(float dt) { }
    37         public void End()    { _cardTable.Clear(); Instance = null; }
    38         public IEnumerator Save() { yield break; }
    39         public IEnumerator Load() { yield break; }
    40 
    41         /// <summary>日志输出（输出Name、Desc、存的数据信息的数量与概括）</summary>
    42         public void Log()
    43         {
    44             int totalCards = _cardTable.Values.Sum(l => l.Count);
    45             LogMgr.Dbg("[{0}] {1} | NpcCount={2}, TotalCards={3}", Name, Desc, _cardTable.Count, totalCards);
    46         }
    47 
    48         // ── 公共 API ──────────────────────────────────────────
    49 
    50         /// <summary>
    51         /// 给指定 NPC 发放一张行为卡
    52         /// </summary>
    53         public void GiveCard(int npcId, string defineId)
    54         {
    55             if (BehaviorCardDataMgr.Instance?.Get(defineId) == null)
    56             {
    57                 LogMgr.Warn("[BehaviorCardMgr] GiveCard 找不到 BehaviorCardDefine '{0}'", defineId);
    58                 return;
    59             }
    60             if (!_cardTable.TryGetValue(npcId, out var list))
    61             {
    62                 list = new List<BehaviorCard>();
    63                 _cardTable[npcId] = list;
    64             }
    65             list.Add(new BehaviorCard(defineId, npcId));
    66             LogMgr.Dbg("[BehaviorCardMgr] GiveCard npc={0} card={1}", npcId, defineId);
    67         }
    68 
    69         /// <summary>
    70         /// 移除指定 NPC 的指定行为卡（移除第一个匹配的 DefineId）
    71         /// </summary>
    72         public void RemoveCard(int npcId, string defineId)
    73         {
    74             if (!_cardTable.TryGetValue(npcId, out var list)) return;
    75             var card = list.FirstOrDefault(c => c.DefineId == defineId);
    76             if (card != null)
    77             {
    78                 list.Remove(card);
    79                 LogMgr.Dbg("[BehaviorCardMgr] RemoveCard npc={0} card={1}", npcId, defineId);
    80             }
    81         }
    82 
    83         /// <summary>
    84         /// 获取指定 NPC 持有的所有行为卡（只读）
    85         /// </summary>
    86         public IReadOnlyList<BehaviorCard> GetCards(int npcId)
    87         {
    88             return _cardTable.TryGetValue(npcId, out var list)
    89                 ? list.AsReadOnly()
    90                 : (IReadOnlyList<BehaviorCard>)Array.Empty<BehaviorCard>();
    91         }
    92 
    93         /// <summary>
    94         /// 使用一张行为卡：
    95         /// 1. 解析 BehaviorCardDefine
    96         /// 2. 优先走 StoryIds（确定性） / 否则 Tags 匹配（涌现性）
    97         /// 3. 通过 StoryMgr.TriggerStory 统一触发
    98         /// 4. 若 IsConsumable 则移除实例
    99         /// </summary>
   100         public void UseCard(int npcId, string defineId, Rng? rng = null)
   101         {
   102             if (!_cardTable.TryGetValue(npcId, out var list)) return;
   103             var card = list.FirstOrDefault(c => c.DefineId == defineId);
   104             if (card == null)
   105             {
   106                 LogMgr.Warn("[BehaviorCardMgr] UseCard npc={0} 未持有 card={1}", npcId, defineId);
   107                 return;
   108             }
   109 
   110             var define = BehaviorCardDataMgr.Instance?.Get(defineId);
   111             if (define == null)
   112             {
   113                 LogMgr.Warn("[BehaviorCardMgr] UseCard 找不到 BehaviorCardDefine '{0}'", defineId);
   114                 return;
   115             }
   116 
   117             var subject = NpcMgr.Instance?.GetById(npcId);
   118 
   119             // 确定要触发的 StoryId
   120             if (define.StoryIds.Count > 0)
   121             {
   122                 // 确定性模式：从列表随机选一个
   123                 var pickRng  = rng ?? new Rng(npcId + card.UsageCount);
   124                 int idx      = pickRng.Range(0, define.StoryIds.Count);
   125                 var storyId  = define.StoryIds[idx];
   126                 StoryMgr.Instance?.TriggerStory(storyId, subject, StoryPoolSource.Will, rng);
   127             }
   128             else if (define.StoryTags.Count > 0)
   129             {
   130                 // 涌现性模式：TagBag 匹配
   131                 StoryMgr.Instance?.TriggerStoryByTags(define.StoryTags, subject, StoryPoolSource.Will, rng);
   132             }
   133             else
   134             {
   135                 LogMgr.Warn("[BehaviorCardMgr] UseCard '{0}' 既无 StoryIds 也无 StoryTags", defineId);
   136             }
   137 
   138             // 记录使用次数
   139             card.UsageCount++;
   140 
   141             // 消耗型卡移除
   142             if (define.IsConsumable)
   143                 list.Remove(card);
   144         }
   145     }
   146 }
   147 


