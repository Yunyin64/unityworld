   118         /// </summary>
   119         public static TileId StepInDirection(TileId from, int direction)
   120             => from.Neighbor(direction);
   121 
   122         /// <summary>
   123         /// 尝试让 NPC 朝指定方向走一步，并校验目标格是否在位面边界内。
   124         /// </summary>
   125         /// <param name="id">NPC ID</param>
   126         /// <param name="direction">方向 0~5（0=右，顺时针）</param>
   127         /// <returns>
   128         ///   <c>MoveResult.Success</c>：移动成功；<br/>
   129         ///   <c>MoveResult.OutOfBounds</c>：目标格超出位面边界；<br/>
   130         ///   <c>MoveResult.NotFound</c>：NPC 位置未注册。
   131         /// </returns>
   132         public NpcTypes.MoveResult TryMove(int id, int direction)
   133         {
   134             if (!_dataTable.TryGetValue(id, out var data)) return NpcTypes.MoveResult.NotFound;
   135 
   136             var target = StepInDirection(data.TileId, direction);
   137             var plane = PlaneMgr.Instance?.GetPlaneById(data.PlaneId);
   138             if (plane == null || !plane.IsInBounds(target)) return NpcTypes.MoveResult.OutOfBounds;
   139 
   140             data.TileId    = target;
   141             data.MoveState = NpcTypes.MoveState.Walking;
   142             return NpcTypes.MoveResult.Success;
   143         }
