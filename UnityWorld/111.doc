     6     /// <summary>
     7     /// NPC 核心实体（轻量句柄，真实数据由各子系统管理）
     8     /// </summary>
     9     public partial class Npc:GameEntityBase
    10     {
    11         /// <summary>唯一 ID（8 位随机整数）</summary>
    12         public int Id { get; }
    13 
    14         /// <summary>属性集合（从 StatMgr 代理获取，数据驱动的属性系统）</summary>
