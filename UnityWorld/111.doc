     1 using System.Collections;
     2 using UnityWorld.Core;
     3 using UnityWorld.Game.Data;
     4 
     5 namespace UnityWorld.Game.Domain
     6 {
     7     /// <summary>
     8     /// NPC 管理器：负责 NPC 的创建、查找、销毁，以及驱动所有 NPC 子系统 Tick
     9     /// </summary>
    10     public class NpcMgr : IDomainMgrBase
    11     {
    12         // ── 子系统 ────────────────────────────────────────
    13         public NpcSystemBio BioSystem { get; } = new();
    14         public NpcSystemPosition PositionSystem { get; } = new();
    15         public NpcSystemName NameSystem { get; }
    16         public NpcSystemRole RoleSystem { get; } = new();
    17         public NpcSystemTrait TraitSystem { get; } = new();
    18         public NpcSystemPractice PracticeSystem { get; } = new();
    19         public NpcSystemFaction FactionSystem { get; } = new();
    20 
    21 
    22         // ── 数据 ─────────────────────────────────────────
    23         private readonly Dictionary<int, Npc> _allNpcs = new();
    24         private readonly Rng _rng;
    25 
    26 
    27         public static  NpcMgr Instance { get; private set; } = null!;
    28 
    29 
    30         public NpcMgr(int seed = 12345)
    31         {
    32             _rng = new Rng(seed);
    33             NameSystem = new NpcSystemName(_rng);
    34             Instance = this;
    35         }
    36 
    37 
    38         // ── 创建 ─────────────────────────────────────────
    39 
    40         /// <summary>
    41         /// 根据配置模板创建一个 NPC，并初始化到指定坐标
    42         /// </summary>
    43         public Npc Create(NpcDefine define, int x = 0, int y = 0)
    44         {
    45             var id = _rng.NewId();
    46             var npc = new Npc(id);
    47 
    48             // ① 随机性别
    49             var gender = (NpcTypes.Gender)_rng.Range(0, 2); // Male=0 / Female=1
    50 
    51             // ② 随机初始属性
    52             float initAge = _rng.Range(define.InitAgeMin, define.InitAgeMax);
    53             int initCultivation = _rng.Range(define.InitCultivationLevelMin, define.InitCultivationLevelMax + 1);
    54 
    55             // ③ 随机姓名（修为>0 则为修士，生成道号）
    56             bool isCultivator = initCultivation > 0;
    57             string fullName = isCultivator
    58                 ? NameSystem.RandomCultivatorFullName(gender)
    59                 : NameSystem.RandomName(gender);
    60 
    61             // ④ 注册到 Name 系统
    62             NameSystem.Register(npc, fullName);
    63 
    64             // ⑤ 注册到 Bio 系统（凡间肉身数据）
    65             BioSystem.Register(npc, new NpcBioData
    66             {
    67                 Name = fullName,
    68                 Gender = gender,
    69                 NpcType = define.NpcType,
    70                 AgeAccumulated = initAge,
    71                 BirthTick = UnityWorld.Game.World.WorldTime.CurrentTick,
    72                 BaseMoveSpeed = define.BaseMoveSpeed,
    73                 AppearanceData = new(),
    74                 IsAlive = true,
    75                 DeathTick = -1,
    76             });
    77 
    78             // ⑥ 注册到 Practice 系统（修行数据，即使凡人也需要寿元上限）
    79             PracticeSystem.Register(npc, new NpcCultivationData
    80             {
    81                 Path = PracticePath.None,
    82                 LifespanMax = define.BaseLifespanMax,
    83                 HpMax = 100,
    84                 MpMax = 50,
    85                 SpMax = 50,
    86             });
    87 
    88             // ⑦ 注册初始角色到 Role 系统
    89             RoleSystem.Register(npc, define.DefaultRoles);
    90 
    91             // ⑧ 注册到 Position 系统
    92             PositionSystem.Register(npc, x, y);
    93 
    94             // ⑨ 注册并应用初始 Trait
    95             TraitMgr.Instance?.Register(npc.Id);
    96             if (define.InitialTraits != null)
    97             {
    98                 foreach (var traitId in define.InitialTraits)
    99                     TraitMgr.Instance?.AddTrait(npc, traitId);
   100             }
   101 
   102             // ⑩ 创建 StatBlock 并注册到 StatMgr
   103             StatMgr.Instance?.CreateBlock(id, "Npc");
   104 
   105             // ⑪ 放入全局表
   106             _allNpcs[id] = npc;
   107 
   108             return npc;
   109         }
   110 
   111         // ── 随机创建 ─────────────────────────────────────
   112 
   113         /// <summary>
   114         /// 随机创建一个修士 NPC（绕过 NpcDefine 模板，直接指定所有参数）
   115         /// </summary>
   116         /// <param name="path">道途类型</param>
   117         /// <param name="realmLevel">境界等级（1~N）</param>
   118         /// <param name="age">当前年龄</param>
   119         /// <param name="lifespanMax">寿元上限</param>
   120         /// <param name="moveSpeed">移动速度</param>
   121         /// <param name="gender">性别</param>
   122         /// <param name="roles">社会角色列表</param>
   123         /// <param name="traitIds">Trait ID 列表</param>
   124         /// <param name="cultivationDefineId">功法定义 ID（可选）</param>
   125         /// <param name="x">X 坐标</param>
   126         /// <param name="y">Y 坐标</param>
   127         /// <returns>创建的 NPC 实例</returns>
   128         public Npc RandomCreate(
   129             PracticePath path,
   130             int realmLevel,
   131             float age,
   132             float lifespanMax,
   133             float moveSpeed,
   134             NpcTypes.Gender gender,
   135             string[] roles,
   136             string[] traitIds,
   137             string cultivationDefineId,
   138             int x,
   139             int y)
   140         {
   141             // ① 生成随机 ID
   142             var id = _rng.NewId();
   143             var npc = new Npc(id);
   144 
   145             // ② 生成修士姓名（道号）
   146             string fullName = NameSystem.RandomCultivatorFullName(gender);
   147 
   148             // ③ 注册 NameSystem
   149             NameSystem.Register(npc, fullName);
   150 
   151             // ④ 注册 BioSystem（凡间肉身数据）
   152             BioSystem.Register(npc, new NpcBioData
   153             {
   154                 Name = fullName,
   155                 Gender = gender,
   156                 NpcType = NpcTypes.NpcType.Human,
   157                 AgeAccumulated = age,
   158                 BirthTick = UnityWorld.Game.World.WorldTime.CurrentTick,
   159                 BaseMoveSpeed = moveSpeed,
   160                 AppearanceData = new(),
   161                 IsAlive = true,
   162                 DeathTick = -1,
   163             });
   164 
   165             // ⑤ 注册 PracticeSystem（修行数据）
   166             PracticeSystem.Register(npc, new NpcCultivationData
   167             {
   168                 Path = path,
   169                 LifespanMax = lifespanMax,
   170                 HpMax = 100,
   171                 MpMax = 50,
   172                 SpMax = 50,
   173             });
   174 
   175             // ⑥ 注册 RoleSystem
   176             RoleSystem.Register(npc, roles);
   177 
   178             // ⑦ 注册 PositionSystem
   179             PositionSystem.Register(npc, x, y);
   180 
   181             // ⑧ 注册 TraitMgr 并循环 AddTrait
   182             TraitMgr.Instance?.Register(npc.Id);
   183             foreach (var traitId in traitIds)
   184             {
   185                 TraitMgr.Instance?.AddTrait(npc, traitId);
   186             }
   187 
   188             // ⑨ 创建 StatBlock
   189             StatMgr.Instance?.CreateBlock(id, "Npc");
   190 
   191             // ⑩ 注册道途到 CultivationMgr（功法槽位管理）
   192             CultivationMgr.Instance?.Register(npc.Id, path);
   193 
   194             // ⑪ 如果指定了功法，分配功法
   195             if (!string.IsNullOrEmpty(cultivationDefineId))
   196             {
   197                 CultivationMgr.Instance?.AddCultivation(npc.Id, cultivationDefineId);
   198             }
   199 
   200             // ⑫ 放入全局字典
   201             _allNpcs[id] = npc;
   202 
   203             return npc;
   204         }
   205 
   206         // ── 查询 ─────────────────────────────────────────
   207 
   208         public Npc GetById(int id)
   209             => _allNpcs.TryGetValue(id, out var npc) ? npc : null;
   210 
   211         public IEnumerable<Npc> GetAll() => _allNpcs.Values;
   212 
   213         public int Count => _allNpcs.Count;
   214 
   215         public string Name =>  
   216 
   217         public string Desc =>  
   218 
   219         // ── Tick ─────────────────────────────────────────
   220 
   221 
   222         /// <summary>
   223         /// 驱动所有 NPC 的所有子系统 Tick（按优先级顺序）
   224         /// </summary>
   225         public void Tick(float deltaTime)
   226         {
   227             foreach (var npc in _allNpcs.Values)
   228             {
   229                 BioSystem.OnTick(npc, deltaTime);
   230                 PracticeSystem.OnTick(npc, deltaTime);
   231                 PositionSystem.OnTick(npc, deltaTime);
   232                 TraitMgr.Instance?.OnTick(npc, deltaTime);
   233             }
   234         }
   235 
   236         // ── 日志 ─────────────────────────────────────────
   237 
   238 
   239         /// <summary>
   240         /// 打印所有NPC的详细信息，包括生平、位置所在Tile地形、所属Region等环境信息。
   241         /// </summary>
   242         /// <param name="year">当前游戏年（仅用于标题显示）</param>
   243         public void NpcAllInfoLog(int year = -1)
   244         {
   245             string header = year >= 0
   246                 ? $"── 第 {year} 年 [Tick={UnityWorld.Game.World.WorldTime.CurrentTick}] ──────────────────"
   247                 : $"── [Tick={UnityWorld.Game.World.WorldTime.CurrentTick}] ──────────────────";
   248             LogMgr.Dbg(header);
   249 
   250             foreach (var npc in _allNpcs.Values)
   251             {
   252                npc.LogAllInfo();
   253             }
   254             LogMgr.Dbg("");
   255         }
