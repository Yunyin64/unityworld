     7     /// NPC 生物系统：管理 NPC 的凡间肉身数据，并每 Tick 推进年龄积累
     8     /// 
     9     /// 职责：
    10     ///   - 管理 NpcBioData 的注册/查询
    11     ///   - 每 Tick 推进年龄（AgeAccumulated）
    12     ///   - 提供基础查询方法：GetAge, GetMoveSpeed
    13     /// 
    14     /// 注意：
    15     ///   - 寿元判定已迁至 NpcSystemPractice
    16     ///   - TimeFlowRate 是 Plane 级别的环境属性（TODO: 需 Plane 支持）
    17     /// </summary>
    18     public class NpcSystemBio : NpcSystemBase<NpcBioData>
    19     {
    20         protected override Dictionary<int, NpcBioData> _dataTable { get ; set ; }
    21 
    22         /// <summary>注册一个 NPC 的生物数据（创建时调用）</summary>
    23         public override void Register(Npc npc, NpcBioData bioData)
    24         {
    25             _dataTable[npc.Id] = bioData;
    26         }
    27 
    28         /// <summary>获取 NPC 的生物数据</summary>
    29         public NpcBioData? GetBio(int id)
    30             => _dataTable.TryGetValue(id, out var data) ? data : null;
    31 
    32         /// <summary>每 Tick 推进年龄积累（由 NpcMgr 驱动）</summary>
    33         /// <remarks>
    34         /// TODO: TimeFlowRate 应从所在 Plane 读取，目前暂用 1.0
    35         /// </remarks>
    36         public override void OnTick(Npc npc, float deltaTime)
    37         {
    38             var bio = GetBio(npc.Id);
    39             if (bio == null) return;
    40             if (!bio.IsAlive) return;
    41 
    42             // 年龄推进（TimeFlowRate 暂为 1.0，等待 Plane 环境属性支持）
    43             bio.AgeAccumulated += deltaTime;
    44         }
    45 
    46         // ── 查询方法 ────────────────────────────────────
    47 
    48         /// <summary>获取 NPC 年龄（年）</summary>
    49         public float GetAge(Npc npc)
    50         {
    51             var bio = GetBio(npc.Id);
    52             return bio?.AgeAccumulated ?? 0f;
    53         }
    54 
    55         /// <summary>获取基础移动速度</summary>
    56         public float GetMoveSpeed(Npc npc)
    57         {
    58             var bio = GetBio(npc.Id);
    59             return bio?.BaseMoveSpeed ?? 3f;
    60         }
    61 
    62         /// <summary>获取出生 Tick</summary>
    63         public int GetBirthTick(Npc npc)
    64         {
    65             var bio = GetBio(npc.Id);
    66             return bio?.BirthTick ?? 0;
    67         }
    68 
    69         /// <summary>获取性别</summary>
    70         public NpcTypes.Gender GetGender(Npc npc)
    71         {
    72             var bio = GetBio(npc.Id);
    73             return bio?.Gender ?? NpcTypes.Gender.Unknown;
    74         }
    75 
    76         /// <summary>获取种族</summary>
    77         public NpcTypes.NpcType GetNpcType(Npc npc)
    78         {
    79             var bio = GetBio(npc.Id);
    80             return bio?.NpcType ?? NpcTypes.NpcType.Human;
    81         }
    82 
    83         /// <summary>是否存活</summary>
    84         public bool IsAlive(Npc npc)
    85         {
    86             var bio = GetBio(npc.Id);
    87             return bio?.IsAlive ?? false;
    88         }
    89 
    90         /// <summary>标记死亡</summary>
    91         public void MarkDead(Npc npc)
    92         {
    93             var bio = GetBio(npc.Id);
    94             if (bio != null)
    95             {
